# PolicyLens Environment Configuration Example
# Copy this file to .env and adjust values for local development.

# Application metadata
POLICYLENS_APP_NAME="PolicyLens"
POLICYLENS_ENVIRONMENT="development"
POLICYLENS_LOG_LEVEL="INFO"
POLICYLENS_DEBUG=false

# LLM and Embedding Configuration
# Supported providers: mock, gemini (or google), groq.
POLICYLENS_LLM_PROVIDER="mock"
POLICYLENS_LLM_MODEL="gemini-2.5-flash"
POLICYLENS_EMBEDDING_MODEL="BAAI/bge-small-en-v1.5"

# Optional Gemini IPv4 source binding for affected local networks (default: false).
# Gemini SDK requests use a 60,000 ms timeout; this is not a total wall-clock deadline.
POLICYLENS_GEMINI_FORCE_IPV4=false

# Optional GroqCloud alternative: install with python -m pip install -e ".[groq]".
# Uncomment these lines to override the provider/model settings above.
# POLICYLENS_LLM_PROVIDER="groq"
# POLICYLENS_LLM_MODEL="qwen/qwen3.8-27b"
# Groq uses a 60-second request timeout with SDK retries disabled.

# Database Configuration (PostgreSQL)
POLICYLENS_DATABASE_URL="postgresql://postgres:postgrespassword@localhost:5433/policylens"

# Qdrant Vector Store
POLICYLENS_QDRANT_URL="http://localhost:6333"
# POLICYLENS_QDRANT_API_KEY=""
POLICYLENS_QDRANT_COLLECTION="policylens_chunks"

# Provider API Keys (leave blank or specify in local .env)
# POLICYLENS_GEMINI_API_KEY=""
# POLICYLENS_GROQ_API_KEY=""
